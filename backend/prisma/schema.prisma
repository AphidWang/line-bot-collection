generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_CONNECTION_STRING")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  password     String?
  name         String?
  avatar       String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  firebaseUid  String?       @unique
  messages     Message[]
  summaries    Summary[]
  userChannels UserChannel[]
  userReads    UserRead[]

  @@map("users")
}

model Channel {
  id           String        @id @default(cuid())
  lineId       String        @unique
  name         String
  pictureUrl   String?
  status       String        @default("active")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  messages     Message[]
  summaries    Summary[]
  userChannels UserChannel[]
  groups       Group[]

  @@map("channels")
}

model Message {
  id         String   @id @default(cuid())
  lineId     String   @unique
  channelId  String
  groupId    String?  // 新增：群組 ID
  userId     String
  userName   String?
  userAvatar String?
  type       String
  content    String
  metadata   Json?
  timestamp  DateTime
  createdAt  DateTime @default(now())
  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  group      Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id])

  @@map("messages")
}

model Group {
  id          String    @id @default(cuid())
  lineId      String    @unique  // Line 群組 ID
  name        String?   // 群組名稱
  pictureUrl  String?   // 群組頭像
  channelId   String    // 所屬頻道
  channel     Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  status      String    @default("active")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  messages    Message[]
  userReads   UserRead[]

  @@map("groups")
}

model UserRead {
  id        String   @id @default(cuid())
  userId    String
  groupId   String
  lastReadMessageId String?  // 最後讀取的訊息 ID
  lastReadAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@map("user_reads")
}

model UserChannel {
  id            String   @id @default(cuid())
  userId        String
  channelId     String
  alias         String?
  isTracked     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  accessToken   String?
  channelSecret String?
  status        String   @default("active")
  userKey       String?
  webhookUrl    String?
  channel       Channel  @relation(fields: [channelId], references: [lineId], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@map("user_channels")
}

model Summary {
  id        String   @id @default(cuid())
  userId    String
  channelId String?
  date      DateTime @db.Date
  content   String
  tokens    Int
  createdAt DateTime @default(now())
  channel   Channel? @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId, date])
  @@map("summaries")
}
