generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_CONNECTION_STRING")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  password     String?
  name         String?
  avatar       String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  firebaseUid  String?       @unique
  messages     Message[]
  summaries    Summary[]
  userChannels UserChannel[]

  @@map("users")
}

model Channel {
  id           String        @id @default(cuid())
  lineId       String        @unique
  name         String
  pictureUrl   String?
  status       String        @default("active")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  messages     Message[]
  summaries    Summary[]
  userChannels UserChannel[]

  @@map("channels")
}

model Message {
  id         String   @id @default(cuid())
  lineId     String   @unique
  channelId  String
  userId     String
  userName   String?
  userAvatar String?
  type       String
  content    String
  metadata   Json?
  timestamp  DateTime
  createdAt  DateTime @default(now())
  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id])

  @@map("messages")
}

model UserChannel {
  id            String   @id @default(cuid())
  userId        String
  channelId     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  accessToken   String?
  channelSecret String?
  status        String   @default("active")
  userKey       String?
  webhookUrl    String?
  channel       Channel  @relation(fields: [channelId], references: [lineId], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@map("user_channels")
}

model Summary {
  id        String   @id @default(cuid())
  userId    String
  channelId String?
  date      DateTime @db.Date
  content   String
  tokens    Int
  createdAt DateTime @default(now())
  channel   Channel? @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId, date])
  @@map("summaries")
}
