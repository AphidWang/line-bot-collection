    "dotenv": "^16.3.1",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "firebase-admin": "^12.0.0",
    "openai": "^4.20.1",
    "@line/bot-sdk": "^10.2.0",
    "prisma": "^5.22.0",
    "@prisma/client": "^5.22.0",
    "zod": "^3.22.4",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "multer": "^1.4.5-lts.1",
