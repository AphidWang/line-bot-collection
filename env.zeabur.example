# Zeabur Deployment Environment Variables
# 複製此檔案為 .env.zeabur 並填入實際值

# =============================================================================
# BACKEND SERVICE (.env)
# =============================================================================

# Server Configuration
PORT=3001
NODE_ENV=production
HOST=0.0.0.0

# Database (PostgreSQL on Zeabur)
POSTGRES_CONNECTION_STRING="postgresql://username:password@host:port/database"

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Firebase Admin SDK (Optional)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# OpenAI API
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.7

# Line Bot API
LINE_CHANNEL_SECRET=your-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_WEBHOOK_URL=https://your-backend-domain.zeabur.app/api/line/webhook

# Security & CORS
CORS_ORIGIN=https://your-frontend-domain.zeabur.app

# =============================================================================
# FRONTEND SERVICE (.env.local)
# =============================================================================

# Backend API URL (指向你的後端服務)
NEXT_PUBLIC_API_URL=https://your-backend-domain.zeabur.app

# Firebase Configuration (Optional)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# App Configuration
NEXT_PUBLIC_APP_NAME=Line Assistant
NEXT_PUBLIC_APP_VERSION=1.0.0

# Feature Flags
NEXT_PUBLIC_ENABLE_FIREBASE_AUTH=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# =============================================================================
# ZEABUR SPECIFIC CONFIGURATION
# =============================================================================

# 在 Zeabur 控制台中設定這些環境變數：
# 1. 後端服務：設定所有 BACKEND 相關變數
# 2. 前端服務：設定所有 FRONTEND 相關變數
# 3. 資料庫服務：設定 DATABASE_URL
# 4. 確保 CORS_ORIGIN 和 NEXT_PUBLIC_API_URL 指向正確的域名
#
# 注意：Zeabur 會自動分配埠號
# - 前端服務通常使用 8080 埠
# - 後端服務通常使用 3001 埠
# - 實際的服務 URL 會在 Zeabur 控制台中顯示
